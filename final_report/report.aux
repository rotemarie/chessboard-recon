\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Confidence score distributions for clean vs. occluded images. Clear separation validates MSP-based OOD detection approach.}}{11}{figure.14}\protected@file@percent }
\newlabel{fig:ood_confidence}{{14}{11}{Confidence score distributions for clean vs. occluded images. Clear separation validates MSP-based OOD detection approach}{figure.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Cumulative distribution functions of confidence scores for clean vs. occluded images across all classes (top) and specifically for black\_queen (bottom). Orange curves (occluded) show consistently lower confidence than blue curves (clean), enabling threshold-based OOD detection. Threshold of 0.5 balances detection sensitivity with avoiding false rejections of difficult-to-classify pieces like queens.}}{11}{figure.15}\protected@file@percent }
\newlabel{fig:ood_graph}{{15}{11}{Cumulative distribution functions of confidence scores for clean vs. occluded images across all classes (top) and specifically for black\_queen (bottom). Orange curves (occluded) show consistently lower confidence than blue curves (clean), enabling threshold-based OOD detection. Threshold of 0.5 balances detection sensitivity with avoiding false rejections of difficult-to-classify pieces like queens}{figure.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Visual demonstration of OOD detection with confidence thresholding. When confidence < 0.5, the system classifies squares as "occluded" and marks them with an 'X' on the reconstructed board. This approach successfully identifies ambiguous predictions while preserving correctly classified difficult pieces (e.g., queens, bishops).}}{11}{figure.16}\protected@file@percent }
\newlabel{fig:ood_demo}{{16}{11}{Visual demonstration of OOD detection with confidence thresholding. When confidence < 0.5, the system classifies squares as "occluded" and marks them with an 'X' on the reconstructed board. This approach successfully identifies ambiguous predictions while preserving correctly classified difficult pieces (e.g., queens, bishops)}{figure.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Comparison of balanced model (trained with undersampled balanced dataset) versus imbalanced model (trained with full imbalanced dataset + weighted sampler). Both models evaluated on balanced and imbalanced test sets. Weighted sampling achieves better performance without discarding data.}}{12}{figure.17}\protected@file@percent }
\newlabel{fig:balanced_comparison}{{17}{12}{Comparison of balanced model (trained with undersampled balanced dataset) versus imbalanced model (trained with full imbalanced dataset + weighted sampler). Both models evaluated on balanced and imbalanced test sets. Weighted sampling achieves better performance without discarding data}{figure.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Comparison of white vs black pieces showing contrast differences: white pieces exhibit clear shadows and contours, while black pieces show weaker visual cues, leading to increased confusion between similar shapes (especially queen vs bishop).}}{12}{figure.18}\protected@file@percent }
\newlabel{fig:confusing_pieces}{{18}{12}{Comparison of white vs black pieces showing contrast differences: white pieces exhibit clear shadows and contours, while black pieces show weaker visual cues, leading to increased confusion between similar shapes (especially queen vs bishop)}{figure.18}{}}
